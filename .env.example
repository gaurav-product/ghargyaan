# GharGyaan runs fully in DEMO MODE with no variables set.
# Set these to enable LIVE AI (framing, phrase mapping, photo context) via the Supabase edge function.
# These are PUBLIC values (anon key); never put provider API keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (set with `supabase secrets set`, never in the browser) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
# or: AI_PROVIDER=openai  OPENAI_API_KEY=  AI_MODEL=gpt-4o-mini
# ALLOWED_ORIGIN=https://your-domain.example

# --- For scripts/embed-kb.ts only (local machine) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# EMBED_MODEL=text-embedding-3-small
